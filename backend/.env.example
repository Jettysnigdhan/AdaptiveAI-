# ==========================================
# AdaptiveRoute Environment Configuration
# ==========================================

# Application
APP_NAME=AdaptiveRoute
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# ----------------------------------------------------
# Provider Mode:
# 'ollama' -> 100% Free Local Models (Default)
# 'xai'    -> Grok API (via xAI) for super-fast cloud inference
# 'hybrid' -> Small/Medium local, Large escalated to Grok
# ----------------------------------------------------
ACTIVE_PROVIDER=ollama

# Local Ollama Settings (Zero-Cost Default)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=120.0

# Local Model Tiers
MODEL_SMALL=qwen2.5:0.5b
MODEL_MEDIUM=qwen2.5-coder:1.5b
MODEL_LARGE=deepseek-r1:8b

# ----------------------------------------------------
# Optional Grok / xAI API Configuration
# Get your API key at: https://console.x.ai/
# ----------------------------------------------------
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
GROK_MODEL_SMALL=grok-2-mini
GROK_MODEL_MEDIUM=grok-2-mini
GROK_MODEL_LARGE=grok-2

# Embedding Model (Sentence Transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Routing & Cascading Policy
DEFAULT_TIER=SMALL
QUALITY_THRESHOLD=0.82
MAX_ESCALATIONS=2
ROUTING_LAMBDA_LATENCY=0.001
ROUTING_LAMBDA_COMPUTE=0.002

# Database
DATABASE_URL=sqlite+aiosqlite:///./adaptiveroute.db
