# ===============================================
# Semantic Cost-Aware LLM Router Configuration
# ===============================================

# LLM Provider & Models (Supported: groq, openai, anthropic, ollama, mock)
LLM_PROVIDER=groq
SMALL_MODEL=groq/openai/gpt-oss-20b
LARGE_MODEL=groq/openai/gpt-oss-120b

# API Keys (leave empty if using local Ollama or mock)
API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=semantic_cache

# Semantic Cache Settings
CACHE_SIMILARITY_THRESHOLD=0.90
CACHE_TTL_SECONDS=86400
CORPUS_VERSION=v1
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Pricing Table (USD per Token)
SMALL_MODEL_INPUT_PRICE=0.0000001
SMALL_MODEL_OUTPUT_PRICE=0.0000002
LARGE_MODEL_INPUT_PRICE=0.000001
LARGE_MODEL_OUTPUT_PRICE=0.000002

# SQLite Database
DATABASE_PATH=data/semantic_router.db
