# ==============================================================================
# AdaptiveRoute Environment Configuration Example
# Copy this file to .env and configure your active provider credentials
# ==============================================================================

# Active Model Provider: 'xai' (Grok), 'groq', 'openai', 'anthropic', or 'ollama'
ACTIVE_PROVIDER=xai

# Routing Mode: 'auto' (ML routing + cascading), 'rule' (rule baseline), or 'fixed'
ROUTING_MODE=auto
FIXED_TIER=medium

# Privacy Settings: Set to false to avoid storing user prompts/completions in SQLite
STORE_PROMPTS=false

# Quality & Cascading Control
QUALITY_THRESHOLD=0.82
MAX_ESCALATIONS=2

# Optimization Weights: Utility = Quality - (lambda_latency * latency_ms) - (lambda_tokens * tokens)
LAMBDA_LATENCY=0.0005
LAMBDA_TOKENS=0.0002

# ==============================================================================
# Provider 1: xAI / Grok (Active Default)
# ==============================================================================
XAI_API_KEY=your_xai_api_key_here
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL_SMALL=grok-2-mini
XAI_MODEL_MEDIUM=grok-2-mini
XAI_MODEL_LARGE=grok-2

# ==============================================================================
# Provider 2: Groq Cloud LPU
# ==============================================================================
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL_SMALL=allam-2-7b
GROQ_MODEL_MEDIUM=qwen/qwen3.8-27b
GROQ_MODEL_LARGE=openai/gpt-oss-120b

# ==============================================================================
# Provider 3: OpenAI (Optional)
# ==============================================================================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_SMALL=gpt-4o-mini
OPENAI_MODEL_MEDIUM=gpt-4o-mini
OPENAI_MODEL_LARGE=gpt-4o

# ==============================================================================
# Provider 4: Anthropic (Optional)
# ==============================================================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL_SMALL=claude-3-5-haiku-20241022
ANTHROPIC_MODEL_MEDIUM=claude-3-5-haiku-20241022
ANTHROPIC_MODEL_LARGE=claude-3-5-sonnet-20241022

# ==============================================================================
# Provider 5: Local / Ollama (Optional)
# ==============================================================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_SMALL=qwen2.5:0.5b
OLLAMA_MODEL_MEDIUM=qwen2.5-coder:1.5b
OLLAMA_MODEL_LARGE=deepseek-r1:8b

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
